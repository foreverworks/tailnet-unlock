#!/bin/sh
# The supervisor: starts the door's daemons, keeps them running, and is the one place that stops
# them and wipes (DESIGN.md section 7.3, step 2; decision D32). init-premount starts it in the
# background; init-bottom and the panic script send it TERM.
set -u
TU_HERE=${0%/*}
# shellcheck source=paths.sh
. "$TU_HERE/paths.sh"
# shellcheck source=lib.sh
. "$TU_HERE/lib.sh"
# shellcheck source=/dev/null
. "$TU_CONF"

# Neither daemon's output is kept: dropbear logs every connection and a scan could fill the 16 MiB
# tmpfs the door's state lives on. The console line says what the supervisor did; that is enough.
dropbear_pid=''
tailscaled_pid=''
dropbear_restart=0
tailscaled_restart=0

# Say so on the console when the door's state cannot be written (a full tmpfs), instead of
# carrying on as if it had been.
record() {
	tu_put "$@" || tu_log "cannot record $1 in the door's state directory (is it full?)"
}

# Both daemons are stopped from the PIDs held in memory as well as from the files: a file that
# could not be written, or not yet, must not leave one running.
supervise_stop() {
	trap '' TERM INT HUP
	tu_stop "$tailscaled_pid" 10 tailscaled
	tu_stop "$dropbear_pid" 5 dropbear
	tu_wipe
	rm -f "$TU_RUN/supervise.pid"
	exit 0
}

# The TERM handler only records the request; the supervisor stops at the next safe point
# (check_stop), never between starting a daemon and holding its PID, so the daemon is never left
# running unrecorded. Doing the work inside the handler hangs busybox 1.38, which cannot fork a
# command substitution from a trap that interrupted `wait`.
stop_pending=0
on_term() {
	stop_pending=1
}
check_stop() {
	if [ "$stop_pending" = 1 ]; then
		supervise_stop
	fi
	return 0
}
trap on_term TERM
trap '' HUP INT

# Sleep that a TERM interrupts at once.
nap() {
	sleep "$1" &
	wait $! 2>/dev/null || :
	check_stop
}

uptime_seconds() {
	# not `read`: see lib.sh
	up=$(head -n 1 2>/dev/null </proc/uptime) || up=0
	up=${up%% *}
	printf '%s' "${up%%.*}"
}

wait_for_tpm() {
	modprobe -q tpm_tis 2>/dev/null || :
	modprobe -q tpm_crb 2>/dev/null || :
	waited=0
	while [ ! -e "$TU_TPM_DEVICE" ] && [ "$waited" -lt 10 ]; do
		nap 1
		waited=$((waited + 1))
	done
	[ -e "$TU_TPM_DEVICE" ]
}

uplink_address=''
uplink_device=''

# ipconfig writes net-<device>.conf from what the DHCP server sent, so the file is read here and
# never sourced: only the two values the supervisor needs are taken, and only when they have the
# shape of a dotted address or an interface name. Anything else counts as absent.
ADDRESS_PATTERN='[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*'
DEVICE_PATTERN='[A-Za-z0-9_.-][A-Za-z0-9_.-]*'

# net_conf_value <file> <variable> <pattern>: the first VAR='value' (or VAR=value) line whose whole
# value matches the pattern, else nothing.
net_conf_value() {
	sed -n -e "s/^$2='\($3\)'\$/\1/p" -e "s/^$2=\($3\)\$/\1/p" "$1" | sed -n 1p
}

# usable_address <dotted>: four decimal octets of 0 to 255 without leading zeros, and a unicast
# address a host can listen on: not 0.0.0.0/8 (which would make dropbear listen on every interface),
# multicast or broadcast.
usable_address() {
	rest=$1.
	count=0
	first=''
	while [ -n "$rest" ]; do
		octet=${rest%%.*}
		rest=${rest#*.}
		case $octet in
		'' | *[!0-9]* | 0?* | ????*) return 1 ;;
		esac
		[ "$octet" -le 255 ] || return 1
		count=$((count + 1))
		[ -n "$first" ] || first=$octet
	done
	[ "$count" -eq 4 ] && [ "$first" -ge 1 ] && [ "$first" -le 223 ]
}

bring_up_uplink() {
	# configure_networking and its helpers come from initramfs-tools
	# shellcheck disable=SC1090 # initramfs-tools' scripts/functions, at boot only
	. "$TU_INITRAMFS_FUNCTIONS"
	IP=$TU_IP
	BOOTIF=$TU_BOOTIF
	DEVICE=''
	export IP BOOTIF DEVICE
	configure_networking >/dev/null 2>&1 || :
	for conf in "$TU_NET_CONF_DIR/net-${DEVICE-}.conf" "$TU_NET_CONF_DIR"/net-*.conf; do
		[ -r "$conf" ] || continue
		uplink_address=$(net_conf_value "$conf" IPV4ADDR "$ADDRESS_PATTERN")
		usable_address "$uplink_address" || uplink_address=''
		uplink_device=$(net_conf_value "$conf" DEVICE "$DEVICE_PATTERN")
		# a device the conf does not name (or names in a shape nothing uses) is the one
		# configure_networking reported
		if [ -z "$uplink_device" ]; then
			case ${DEVICE-} in
			'' | *[!A-Za-z0-9_.-]*) ;;
			*) uplink_device=$DEVICE ;;
			esac
		fi
		break
	done
	record uplink_device "$uplink_device"
	if [ -n "$TU_DNS" ] && [ -n "$uplink_address" ]; then
		: >/etc/resolv.conf
		for server in $TU_DNS; do
			printf 'nameserver %s\n' "$server" >>/etc/resolv.conf
		done
	fi
}

# Unseal (or fall back to the recovery key) and leave the key path in door_key_path.
door_key_path=''
choose_key() {
	door_key_path=''
	if [ "$(tu_get seal)" != ok ] && [ "$(tu_get role)" = recovery ]; then
		door_key_path=$TU_ETC/recovery_host_key
		return 0
	fi
	if [ ! -d "$TU_ETC/door.tpm" ]; then
		seal=no-container
	elif [ ! -e "$TU_TPM_DEVICE" ]; then
		seal=no-tpm
	elif "$TU_LIB/unseal" "$TU_ETC/door.tpm" "$TU_RUN/door_key" 2>/dev/null; then
		record seal ok
		record role sealed
		door_key_path=$TU_RUN/door_key
		return 0
	else
		seal=unseal-failed
	fi
	record seal "$seal"
	if [ "$TU_RECOVERY" != off ] && [ -r "$TU_ETC/recovery_host_key" ]; then
		record role recovery
		door_key_path=$TU_ETC/recovery_host_key
		return 0
	fi
	record role none
	return 1
}

# Start dropbear with the key at $door_key_path, as the role in the state says.
launch_dropbear() {
	listen=''
	role=$(tu_get role)
	if [ "$role" = sealed ] || [ "$TU_RECOVERY" = uplink+tailnet ]; then
		listen="-p 127.0.0.1:$TU_PORT"
	fi
	[ -n "$uplink_address" ] && listen="$listen -p $uplink_address:$TU_PORT"
	if [ -z "$listen" ]; then
		[ "$door_key_path" = "$TU_RUN/door_key" ] && tu_shred "$TU_RUN/door_key"
		return 1
	fi
	rm -f "$TU_RUN/dropbear.pid"
	# shellcheck disable=SC2086 # $listen holds separate -p arguments on purpose
	dropbear -F -E -r "$door_key_path" $listen -s -j -k -I "$TU_IDLE_TIMEOUT" \
		-P "$TU_RUN/dropbear.pid" </dev/null >/dev/null 2>&1 &
	dropbear_pid=$!
	record dropbear.child "$dropbear_pid"
	check_stop
	# dropbear keeps its host key in memory: once it has written its PID file the plaintext
	# door key can go (DESIGN.md 7.3 step 2.4)
	waited=0
	while [ ! -s "$TU_RUN/dropbear.pid" ] && [ "$waited" -lt 50 ] && tu_alive "$dropbear_pid"; do
		sleep 0.1 2>/dev/null || sleep 1
		waited=$((waited + 1))
	done
	[ "$door_key_path" = "$TU_RUN/door_key" ] && tu_shred "$TU_RUN/door_key"
	tu_alive "$dropbear_pid"
}

start_dropbear() {
	choose_key || return 1
	launch_dropbear
}

# Stop dropbear and forget it, reaping it so its PID is not held once it is gone.
stop_dropbear() {
	tu_stop "$dropbear_pid" 5 dropbear
	[ -n "$dropbear_pid" ] && wait "$dropbear_pid" 2>/dev/null
	dropbear_pid=''
	rm -f "$TU_RUN/dropbear.child" "$TU_RUN/dropbear.pid"
}

# The TPM refused at boot (or was not there yet) and the door runs on the recovery key, or on
# none: try again, and when it unseals, move the door to the sealed key. Retried with a backoff
# from 2 to 60 seconds for as long as the container and the TPM are there.
unseal_backoff=2
unseal_next=0
unseal_wanted() {
	[ "$(tu_get seal)" != ok ] && [ -d "$TU_ETC/door.tpm" ] && [ -e "$TU_TPM_DEVICE" ]
}
retry_unseal() {
	now=$(uptime_seconds)
	[ "$now" -ge "$unseal_next" ] || return 0
	if ! "$TU_LIB/unseal" "$TU_ETC/door.tpm" "$TU_RUN/door_key" 2>/dev/null; then
		tu_shred "$TU_RUN/door_key"
		unseal_next=$((now + unseal_backoff))
		unseal_backoff=$((unseal_backoff * 2))
		[ "$unseal_backoff" -gt 60 ] && unseal_backoff=60
		return 0
	fi
	record seal ok
	record role sealed
	stop_dropbear
	door_key_path=$TU_RUN/door_key
	tu_log "the TPM unsealed the door key on a retry; the door now presents the sealed key" \
		"${TU_SEALED_FP:+(key $TU_SEALED_FP)}"
	if ! launch_dropbear; then
		tu_log "the door could not start with the sealed key; retrying"
		dropbear_restart=1
	fi
}

tailnet_wanted() {
	[ "$TU_TAILNET" = yes ] && [ -x /usr/sbin/tailscaled ] && [ -r "$TU_ETC/unlock.state" ]
}

start_tailscaled() {
	tailnet_wanted || return 1
	[ -e "$TU_RUN/unlock.state" ] || cp "$TU_ETC/unlock.state" "$TU_RUN/unlock.state" || return 1
	/usr/sbin/tailscaled --state="$TU_RUN/unlock.state" --encrypt-state \
		--tun=userspace-networking --socket="$TU_RUN/tailscaled.sock" --no-logs-no-support \
		</dev/null >/dev/null 2>&1 &
	tailscaled_pid=$!
	record tailscaled.child "$tailscaled_pid"
	check_stop
}

summary() {
	role=$(tu_get role)
	case "$role" in
	sealed) fp=${TU_SEALED_FP-} ;;
	recovery) fp=${TU_RECOVERY_FP-} ;;
	*) fp='' ;;
	esac
	tu_log "profile ${TU_PROFILE} seal $(tu_get seal) door ${role} ${fp:+key $fp }uplink" \
		"${uplink_address:-none}:${TU_PORT} unlock node" \
		"$([ "$TU_TAILNET" = yes ] && printf '%s' "$TU_UNLOCK_HOSTNAME" || printf off)" \
		"boot $(tu_boot_id)"
}

# A daemon that exited is started again after a backoff that doubles from 1 to 30 seconds and
# resets after a minute of uptime.
supervise_loop() {
	dropbear_backoff=1
	tailscaled_backoff=1
	dropbear_since=$(uptime_seconds)
	tailscaled_since=$dropbear_since
	while :; do
		nap 2
		if [ "$dropbear_restart" = 1 ] || { [ -n "$dropbear_pid" ] && ! tu_alive "$dropbear_pid"; }; then
			if [ -n "$dropbear_pid" ]; then
				wait "$dropbear_pid" 2>/dev/null || :
				dropbear_pid=''
			fi
			now=$(uptime_seconds)
			[ $((now - dropbear_since)) -ge 60 ] && dropbear_backoff=1
			tu_count restarts.dropbear || tu_log "cannot count the door's restarts"
			tu_log "the door (dropbear) exited; starting it again in ${dropbear_backoff}s"
			nap "$dropbear_backoff"
			if start_dropbear; then
				dropbear_restart=0
			else
				dropbear_restart=1
				tu_log "the door could not start again; retrying"
			fi
			dropbear_since=$(uptime_seconds)
			dropbear_backoff=$((dropbear_backoff * 2))
			[ "$dropbear_backoff" -gt 30 ] && dropbear_backoff=30
		elif unseal_wanted; then
			retry_unseal
		fi
		if [ "$tailscaled_restart" = 1 ] ||
			{ [ -n "$tailscaled_pid" ] && ! tu_alive "$tailscaled_pid"; }; then
			if [ -n "$tailscaled_pid" ]; then
				wait "$tailscaled_pid" 2>/dev/null || :
				tailscaled_pid=''
			fi
			now=$(uptime_seconds)
			[ $((now - tailscaled_since)) -ge 60 ] && tailscaled_backoff=1
			tu_count restarts.tailscaled || tu_log "cannot count the unlock node's restarts"
			tu_log "the unlock node (tailscaled) exited; starting it again in" \
				"${tailscaled_backoff}s"
			nap "$tailscaled_backoff"
			if start_tailscaled; then
				tailscaled_restart=0
			else
				tailscaled_restart=1
				tu_log "the unlock node could not start again; retrying"
			fi
			tailscaled_since=$(uptime_seconds)
			tailscaled_backoff=$((tailscaled_backoff * 2))
			[ "$tailscaled_backoff" -gt 30 ] && tailscaled_backoff=30
		fi
	done
}

# a supervisor that cannot record itself could never be told to stop
if ! tu_put supervise.pid "$$"; then
	tu_log "cannot record the supervisor in the door's state directory; no door this boot"
	tu_wipe
	exit 1
fi
record restarts.dropbear 0
record restarts.tailscaled 0
if tu_noshell; then
	# a kernel panic reboots instead of hanging (DESIGN.md 7.3, exit paths)
	printf '10\n' >"$TU_KERNEL_PANIC" 2>/dev/null || :
fi
wait_for_tpm || tu_log "no TPM at $TU_TPM_DEVICE after 10 seconds"
check_stop
bring_up_uplink
check_stop
tu_log "uplink ${uplink_device:-none} ${uplink_address:-without an address}"
if ! start_dropbear; then
	tu_log "no door this boot: seal $(tu_get seal), recovery ${TU_RECOVERY}; the console prompt" \
		"remains"
fi
check_stop
start_tailscaled || :
summary
supervise_loop
