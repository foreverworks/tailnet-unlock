# The tailnet tier's pinned downloads, read by tests/vm/tailnet.py and sourced by provision.sh.
# Renovate moves the versions (renovate.json); a hash is the file's published SHA-256, so a new
# version fails the download check until `python3 tests/vm/tailnet.py pins` has printed its hashes
# and they are pasted here: a moved release can never change what the suite runs unnoticed.

# renovate: datasource=github-releases depName=juanfont/headscale extractVersion=^v(?<version>.*)$
HEADSCALE_VERSION=0.29.7
HEADSCALE_SHA256=e827fc9b12d958bc95b081c4401dd63f8e0471d025b45b508535a920532150a8

# renovate: datasource=github-releases depName=tailscale/tailscale extractVersion=^v(?<version>.*)$
TAILSCALE_VERSION=1.104.7
# the static build the host's keyholder and test peers run
TAILSCALE_TGZ_SHA256=e56693ff74a64f2591b7e819c280635a100aae1ddfb0ef058fcd052b7cd8d16c
# the signing key of the apt repository the guest installs the same version from
TAILSCALE_KEYRING_SHA256=3e03dacf222698c60b8e2f990b809ca1b3e104de127767864284e6c228f1fb39
