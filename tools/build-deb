#!/bin/sh
# Build tailnet-unlock_<version>_all.deb into <outdir>: tools/build-deb <version> <outdir>
#
# The package is reproducible: the same commit gives the same bytes. File times are the commit's
# time (SOURCE_DATE_EPOCH, taken from git unless the environment sets it), owners are root, modes
# are fixed here, and dpkg-deb sorts the members. Needs dpkg-deb, gzip, find, sort and md5sum.
set -eu

[ $# -eq 2 ] || { echo "usage: tools/build-deb <version> <outdir>" >&2; exit 2; }
version=$1
outdir=$2
case $version in
*[!0-9A-Za-z.+~]* | "" | [!0-9]*)
	echo "build-deb: not a Debian version: $version" >&2
	exit 2
	;;
*) ;;
esac

here=$(cd "${0%/*}/.." && pwd)
if [ -z "${SOURCE_DATE_EPOCH:-}" ]; then
	SOURCE_DATE_EPOCH=$(git -C "$here" log -1 --format=%ct 2>/dev/null) || SOURCE_DATE_EPOCH=
	[ -n "$SOURCE_DATE_EPOCH" ] || {
		echo "build-deb: no git history here; set SOURCE_DATE_EPOCH" >&2
		exit 2
	}
fi
export SOURCE_DATE_EPOCH
umask 022

mkdir -p "$outdir"
outdir=$(cd "$outdir" && pwd)
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT INT TERM
root=$stage/root
mkdir "$root"

sh "$here/tools/install-tree" "$root"

doc=$root/usr/share/doc/tailnet-unlock
install -d "$doc/examples"
install -m 0644 "$here/LICENSE" "$doc/copyright"
install -m 0644 "$here/README.md" "$doc/README.md"
for f in box.toml keyholder.toml approver.py policy.hujson; do
	install -m 0644 "$here/examples/$f" "$doc/examples/$f"
done
gzip -9n <"$here/CHANGELOG.md" >"$doc/changelog.gz"
gzip -9n <"$here/DESIGN.md" >"$doc/DESIGN.md.gz"
chmod 0644 "$doc/changelog.gz" "$doc/DESIGN.md.gz"

# modes that do not depend on the checkout's umask
find "$root" -type d -exec chmod 0755 {} +
find "$root/usr/lib/python3/dist-packages" "$doc" -type f -exec chmod 0644 {} +

ctl=$root/DEBIAN
mkdir "$ctl"
size=$(du -sk --apparent-size "$root" | cut -f1)
sed -e "s/@VERSION@/$version/" -e "s/@SIZE@/$size/" "$here/packaging/control" >"$ctl/control"
install -m 0644 "$here/packaging/triggers" "$here/packaging/conffiles" "$ctl/"
install -m 0755 "$here/packaging/postinst" "$here/packaging/prerm" "$here/packaging/postrm" "$ctl/"
(
	cd "$root"
	find . -type f ! -path './DEBIAN/*' | LC_ALL=C sort | sed 's/^\.\///' | while IFS= read -r f; do
		md5sum "$f"
	done >DEBIAN/md5sums
)
chmod 0644 "$ctl/control" "$ctl/md5sums"

deb=$outdir/tailnet-unlock_${version}_all.deb
rm -f "$deb"
dpkg-deb --root-owner-group -Zxz -z6 --build "$root" "$deb" >/dev/null
echo "$deb"
